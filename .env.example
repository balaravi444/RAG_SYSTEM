# Environment Configuration
# Copy this file to .env and fill in your values

# ─── Groq API ────────────────────────────────────────────
GROQ_API_KEY=

# Model to use for generation (see https://console.groq.com/docs/models)
LLM_MODEL_NAME=openai/gpt-oss-120b

# Required for document uploads and reset actions in the web UI/API
# Use a long, random value and store it as a secret in production
ADMIN_API_KEY=

# ─── Embedding Model ─────────────────────────────────────
# HuggingFace embedding model (runs locally, no API key needed)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ─── ChromaDB ────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# ─── Document Processing ─────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ─── Retrieval ────────────────────────────────────────────
# Number of relevant chunks to retrieve for context
RETRIEVAL_TOP_K=5

# ─── FastAPI Server ──────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=INFO
